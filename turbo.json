{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"env": [
				"DATABASE_URL",
				"BASE_URL",
				"NODE_ENV",
				"NEXT_PUBLIC_URL",
				"BETTER_AUTH_SECRET"
			],
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"lint": {},
		"test": {},
		"test:e2e": {},

		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:deploy": {
			"cache": false
		}
	}
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model WithdrawalRequest {
  id        String  @id @default(cuid())
  derivId   String
  amount    Float
  amountNgn Float
  currency  String  @default("USD")
  derivRef  String?

  createdAt DateTime         @default(now())
  status    WithdrawalStatus @default(PENDING)
  payout    Payout?
}

model Payout {
  id                  String             @id @default(cuid())
  amount              Float
  recipientName       String?
  recipientAccount    String?
  reciepientBank      String?
  createdAt           DateTime           @default(now())
  withdrawalRequestId String?            @unique
  withdrawal          WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
  status              PayoutStatus       @default(UNMATCHED)
  flagReason          String?
}

enum WithdrawalStatus {
  PENDING // email received, awaiting staff payout
  MATCHED // payout found, amounts reconcile
  FLAGGED // payout found but amount mismatch
  MISSING // no payout recieved after threshold
}

enum PayoutStatus {
  UNMATCHED // payout recieved, no withdrawal email found
  MATCHED // clean match
  FLAGGED // no corresponding withdrawal / amount off
}

{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "es2020",
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "drizzle.config.ts"]
}
